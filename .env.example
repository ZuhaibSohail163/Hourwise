# Copy this file to `.env` and adjust the values.
#   cp .env.example .env

# ---- Database (used by docker compose) ----
POSTGRES_USER=hourwise
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=hourwise
POSTGRES_PORT=5432

# Optional: use a hosted Postgres instead of the bundled `db` container.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# ---- Backend ----
# Secret used to sign login tokens. MUST be at least 32 random characters.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
# How long a login lasts, in hours (168 = 7 days).
JWT_TTL_HOURS=168

# The first admin account. It is created on startup ONLY if no admin exists yet.
# Change the password from the Profile page after your first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrator

# ---- Host ports ----
BACKEND_PORT=8080
FRONTEND_PORT=3000
