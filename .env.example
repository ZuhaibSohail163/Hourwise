# Copy this file to `.env` and adjust the values.
#   cp .env.example .env
# Never commit `.env`: it holds secrets. It is listed in .gitignore.

# ---- Database: PostgreSQL (the `db` service in docker-compose.yml) ----
# The backend's DATABASE_URL is built from these. Use a URL-safe password (letters and digits),
# e.g. generate one with:  openssl rand -hex 24
POSTGRES_USER=hourwise
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_DB=hourwise
# Host port for PostgreSQL (bound to 127.0.0.1 only). Change it if 5432 is already in use.
POSTGRES_PORT=5432
# Connection pool size per backend instance.
DATABASE_MAX_CONNECTIONS=10

# ---- Backend ----
# Secret used to sign login sessions. MUST be at least 32 random characters.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
# How long a login lasts, in hours (168 = 7 days).
JWT_TTL_HOURS=168
# Session cookies get the `Secure` flag (HTTPS only). Browsers treat http://localhost as secure,
# so keep this `true`; set `false` only to test over plain http on a LAN IP.
COOKIE_SECURE=true
# Failed logins allowed per email FROM ONE CLIENT ADDRESS before that pair is locked for
# LOGIN_LOCKOUT_SECS seconds, and per client address across all emails (password spraying).
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_LOCKOUT_SECS=900
# Password hashes/verifications allowed at the same time (each uses ~19 MB of memory).
PASSWORD_HASH_CONCURRENCY=4
# Keep EMPTY locally: the frontend's port is reachable directly, so X-Forwarded-For can be faked.
# (Locally every browser therefore shares the frontend container's address for rate limiting.)
# In production behind Traefik, see docs/DEPLOYMENT.md.
TRUSTED_PROXIES=

# The first admin account. It is created on startup ONLY if no admin exists yet.
# Change the password from the Profile page after your first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrator

# ---- Host ports ----
BACKEND_PORT=8080
FRONTEND_PORT=3000
