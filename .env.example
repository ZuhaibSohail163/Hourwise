# Copy this file to `.env` and adjust the values.
#   cp .env.example .env
# Never commit `.env`: it holds secrets. It is listed in .gitignore.

# ---- Database: Turso Cloud ----
# Leave both empty to use a free local database file inside the `dbdata` Docker volume.
# Fill them in to use your hosted Turso database (README -> "Turso Cloud setup"):
#   turso db show hourwise --url        -> TURSO_DATABASE_URL
#   turso db tokens create hourwise     -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Optional: Turso Cloud integration test (npm run test:turso) ----
# A SEPARATE, EMPTY database, never the one above. Used only by the test runner
# (scripts/cargo.mjs), never by the app containers.
#   turso db create hourwise-test
#   turso db show hourwise-test --url       -> HOURWISE_TEST_TURSO_URL
#   turso db tokens create hourwise-test    -> HOURWISE_TEST_TURSO_TOKEN
HOURWISE_TEST_TURSO_URL=
HOURWISE_TEST_TURSO_TOKEN=

# ---- Backend ----
# Secret used to sign login sessions. MUST be at least 32 random characters.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
# How long a login lasts, in hours (168 = 7 days).
JWT_TTL_HOURS=168
# Session cookies get the `Secure` flag (HTTPS only). Browsers treat http://localhost as secure,
# so keep this `true`; set `false` only to test over plain http on a LAN IP.
COOKIE_SECURE=true
# Failed logins allowed per email before it is locked for LOGIN_LOCKOUT_SECS seconds.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECS=900

# The first admin account. It is created on startup ONLY if no admin exists yet.
# Change the password from the Profile page after your first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrator

# ---- Host ports ----
BACKEND_PORT=8080
FRONTEND_PORT=3000
