# Used only when running the backend directly with `cargo run` (not in Docker).
#   cp .env.example .env
# Local database file (created automatically). For Turso Cloud use:
#   TURSO_DATABASE_URL=libsql://hourwise-<your-org>.turso.io
#   TURSO_AUTH_TOKEN=<token from `turso db tokens create hourwise`>
TURSO_DATABASE_URL=file:./data/hourwise.db
TURSO_AUTH_TOKEN=
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_TTL_HOURS=168
COOKIE_SECURE=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECS=900
BIND_ADDR=127.0.0.1:8080
UPLOAD_DIR=./uploads
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrator
# Only needed if the browser calls the API directly (not via the Next.js proxy).
# CORS_ORIGIN=http://localhost:3000
RUST_LOG=hourwise_backend=debug,tower_http=info
