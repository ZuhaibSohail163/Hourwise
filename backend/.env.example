# Used only when running the backend outside Docker (`npm run dev:backend` or `cargo run`).
#   cp .env.example .env
# Start PostgreSQL first with `docker compose up -d db`. User, password, database and port must
# match POSTGRES_* in the root .env.
DATABASE_URL=postgres://hourwise:replace-with-a-random-local-password@localhost:5432/hourwise
# Optional pool tuning (defaults shown).
# DATABASE_MAX_CONNECTIONS=10
# DATABASE_ACQUIRE_TIMEOUT_SECS=5
# DATABASE_STATEMENT_TIMEOUT_SECS=30
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_TTL_HOURS=168
COOKIE_SECURE=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_LOCKOUT_SECS=900
PASSWORD_HASH_CONCURRENCY=4
# Comma-separated IPs/CIDR ranges whose X-Forwarded-For is trusted. Empty = ignore the header.
TRUSTED_PROXIES=
BIND_ADDR=127.0.0.1:8080
UPLOAD_DIR=./uploads
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrator
# Only needed if the browser calls the API directly (not via the Next.js proxy).
# CORS_ORIGIN=http://localhost:3000
RUST_LOG=hourwise_backend=debug,tower_http=info
