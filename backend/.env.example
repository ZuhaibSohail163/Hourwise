# Used only when running the backend directly with `cargo run` (not in Docker).
#   cp .env.example .env
DATABASE_URL=postgres://hourwise:hourwise@localhost:5432/hourwise
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_TTL_HOURS=168
BIND_ADDR=127.0.0.1:8080
UPLOAD_DIR=./uploads
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrator
# Only needed if the browser calls the API directly (not via the Next.js proxy).
# CORS_ORIGIN=http://localhost:3000
RUST_LOG=hourwise_backend=debug,tower_http=info
